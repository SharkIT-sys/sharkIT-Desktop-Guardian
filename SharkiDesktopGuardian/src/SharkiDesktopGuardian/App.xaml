<Application x:Class="SharkiDesktopGuardian.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Paleta compartida del ecosistema sharkit-sys (ver Skin_SystemMonitor_Rainmeter). -->
        <SolidColorBrush x:Key="PanelBrush" Color="#EC10151F" />
        <SolidColorBrush x:Key="CardBrush" Color="#D91B2430" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00C8FF" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFC800" />
        <SolidColorBrush x:Key="CriticalBrush" Color="#FF5050" />
        <SolidColorBrush x:Key="TextBrush" Color="#DCDCDC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8C97A3" />
        <SolidColorBrush x:Key="BarBackgroundBrush" Color="#323232" />
        <SolidColorBrush x:Key="DownloadBrush" Color="#00DC64" />
        <SolidColorBrush x:Key="UploadBrush" Color="#FF7864" />
        <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#263849" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="BorderBrush" Value="#436178" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#15202C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="BorderBrush" Value="#436178" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>
        <Style TargetType="ProgressBar" x:Key="SkinBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource BarBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Resources>
</Application>
