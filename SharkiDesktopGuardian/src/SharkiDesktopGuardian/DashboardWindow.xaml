<Window x:Class="SharkiDesktopGuardian.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sharki · Estado local"
        Width="380" Height="560" MinWidth="320" MinHeight="360" MaxWidth="900" MaxHeight="960"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        Closing="Window_Closing"
        MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
    <Window.Resources>
        <Style x:Key="Separator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#332C3A46" />
            <Setter Property="Margin" Value="0,10" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricDetail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Scrollbar minimalista: pista sin flechas, pulgar fino tipo overlay. -->
        <Style x:Key="SlimScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#4DFFFFFF" CornerRadius="3" Margin="1,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlimRepeatButton" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Width="5">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SlimRepeatButton}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollBarThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SlimRepeatButton}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="18" Background="{StaticResource PanelBrush}" BorderBrush="#5500C8FF" BorderThickness="1.5" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.55" BlurRadius="24" ShadowDepth="6" Direction="270" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4" Background="Transparent"
                      Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown"
                      ToolTip="Arrastra desde esta cabecera para mover el panel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Text="Sharki · Estado local" Foreground="White" FontFamily="{StaticResource AppFont}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="UpdatedText" Text="Esperando datos…" Style="{StaticResource MetricDetail}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="StatusBadge" Background="#183B49" CornerRadius="10" Padding="12,6" VerticalAlignment="Top">
                        <TextBlock x:Name="StatusText" Text="Inicializando" Foreground="White" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Separator}" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <!-- CPU -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="CpuValue" Text="—" Style="{StaticResource MetricValue}" />
                                <TextBlock x:Name="CpuTemperature" Style="{StaticResource MetricDetail}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="CpuBar" Style="{StaticResource SkinBar}" Margin="0,6,0,0" />

                        <!-- GPU -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GPU NVIDIA" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="GpuValue" Text="—" Style="{StaticResource MetricValue}" />
                                <TextBlock x:Name="GpuTemperature" Style="{StaticResource MetricDetail}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="GpuBar" Style="{StaticResource SkinBar}" Margin="0,6,0,0" />
                        <TextBlock x:Name="GpuMemory" Style="{StaticResource MetricDetail}" Margin="0,4,0,0" />

                        <!-- RAM -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RAM" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="MemoryValue" Text="—" Style="{StaticResource MetricValue}" />
                        </Grid>
                        <ProgressBar x:Name="MemoryBar" Style="{StaticResource SkinBar}" Margin="0,6,0,0" />
                        <TextBlock x:Name="MemoryDetail" Style="{StaticResource MetricDetail}" Margin="0,4,0,0" />

                        <Border Style="{StaticResource Separator}" />

                        <!-- Red -->
                        <TextBlock Text="Red" Style="{StaticResource MetricLabel}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Descarga" Style="{StaticResource MetricDetail}" />
                                <TextBlock x:Name="NetworkDownloadValue" Text="—" Foreground="{StaticResource DownloadBrush}"
                                           FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Subida" Style="{StaticResource MetricDetail}" />
                                <TextBlock x:Name="NetworkUploadValue" Text="—" Foreground="{StaticResource UploadBrush}"
                                           FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Separator}" />

                        <!-- Discos (dinámico, una fila por unidad fija) -->
                        <TextBlock Text="Almacenamiento" Style="{StaticResource MetricLabel}" Margin="0,0,0,6" />
                        <StackPanel x:Name="DisksPanel" />

                        <StackPanel x:Name="DiagnosticsPanel" Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Voz: SAPI local + gramática cerrada." Style="{StaticResource MetricDetail}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Margin="6,0,0,0" Click="Listen_Click">Escuchar</Button>
                    <Button Grid.Column="2" x:Name="SpeechButton" Margin="6,0,0,0" Click="ToggleSpeech_Click">Silenciar</Button>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Click="Tutorial_Click">Tutorial</Button>
                        <Button Margin="6,0,0,0" Click="Settings_Click">Ajustes</Button>
                        <Button Margin="6,0,0,0" Click="Hide_Click">Ocultar</Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Grip de redimensionado manual: AllowsTransparency desactiva el resize nativo por bordes. -->
        <Thumb x:Name="ResizeGrip" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,4,4" Cursor="SizeNWSE" DragDelta="ResizeGrip_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" IsHitTestVisible="False"
              Data="M 0,14 L 14,0 M 5,14 L 14,5 M 10,14 L 14,10" Stroke="#66FFFFFF" StrokeThickness="1.5" />
    </Grid>
</Window>
