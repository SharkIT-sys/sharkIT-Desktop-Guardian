<Window x:Class="SharkiDesktopGuardian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SharkiDesktopGuardian.Controls"
        Title="Sharki"
        Width="272" Height="342"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_MouseRightButtonUp">
    <Window.Resources>
        <Style x:Key="PetButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Glow" Fill="#33FFC94A" Opacity="0" />
                            <Ellipse Stroke="#FFD8A93A" StrokeThickness="2">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFB0242E" Offset="0" />
                                        <GradientStop Color="#FF6E141C" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="PetMenu">
            <MenuItem Header="Abrir panel" Click="OpenDashboard_Click" />
            <MenuItem Header="Escuchar orden" Click="Listen_Click" />
            <Separator />
            <MenuItem x:Name="PauseMenuItem" Header="Pausar monitorización" Click="PauseMonitoring_Click" />
            <MenuItem x:Name="DemoMenuItem" Header="Modo demostración" Click="ToggleDemo_Click" IsCheckable="True" />
            <MenuItem Header="Tutorial" Click="Tutorial_Click" />
            <MenuItem Header="Ajustes" Click="Settings_Click" />
            <Separator />
            <MenuItem Header="Salir" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="PetScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Border x:Name="SpeechBubble" VerticalAlignment="Top" HorizontalAlignment="Center"
                MaxWidth="260" Padding="14,10" CornerRadius="14"
                Background="#F3111923" BorderBrush="#8800C8FF" BorderThickness="1.5"
                Visibility="Collapsed">
            <TextBlock x:Name="SpeechText" Foreground="White" FontSize="16" FontFamily="Segoe UI"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </Border>

        <Grid Width="220" Height="238" VerticalAlignment="Bottom" HorizontalAlignment="Center"
              Background="Transparent"
              MouseEnter="PetArea_MouseEnter">
            <controls:SpriteAnimator x:Name="PetAnimator" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <Button x:Name="MicrophoneButton" Style="{StaticResource PetButton}"
                        ToolTip="Escuchar una orden local" Click="Listen_Click">🎙</Button>
                <Button Style="{StaticResource PetButton}"
                        ToolTip="Mostrar el panel" Click="OpenDashboard_Click">▤</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
