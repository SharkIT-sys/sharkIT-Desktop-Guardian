<Window x:Class="SharkiDesktopGuardian.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes de Sharki" Width="610" Height="720" MinHeight="600" Topmost="True"
        Background="#0C1118" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Personalización local" Foreground="White" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Todos los cambios se guardan en Data/settings.json junto a la aplicación."
                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <GroupBox Header="Identidad" Foreground="White" Margin="0,0,0,12" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Nombre" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="PetNameBox" />
                        <TextBlock Grid.Row="1" Text="Color principal (#RRGGBB)" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="AccentColorBox" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Text="Color de alerta (#RRGGBB)" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="AlertColorBox" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Text="Tamaño (0,55–2,25)" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="PetScaleBox" Margin="0,8,0,0" />
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,0">
                            <CheckBox x:Name="AnimationsCheck" Content="Animaciones" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Monitorización y alertas" Foreground="White" Margin="0,0,0,12" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="MonitoringCheck" Content="Monitorización activa" Grid.ColumnSpan="2" />
                        <TextBlock Grid.Row="1" Text="Intervalo (segundos)" Margin="0,8,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="PollingBox" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Text="Temperatura CPU (°C)" Margin="0,8,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="CpuTemperatureBox" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Text="Temperatura GPU (°C)" Margin="0,8,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="GpuTemperatureBox" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="4" Text="Carga CPU/GPU (%)" Margin="0,8,0,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="CpuLoadBox" Width="80" />
                            <TextBox x:Name="GpuLoadBox" Width="80" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="5" Text="RAM elevada (%)" Margin="0,8,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="MemoryBox" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="6" Text="Aviso de disco libre (%)" Margin="0,8,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="DiskFreeBox" Margin="0,8,0,0" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Sensores avanzados" Foreground="White" Margin="0,0,0,12" Padding="12">
                    <StackPanel>
                        <CheckBox x:Name="AlwaysElevatedCheck" Content="Iniciar siempre con permisos de administrador" />
                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Activado por defecto para leer la temperatura de CPU y de los discos. Windows pedirá confirmación (UAC) cada vez que Sharki arranque; si la cancelas, la aplicación sigue funcionando con carga y espacio libre, que no requieren permisos especiales. Desactívalo aquí si prefieres que Sharki nunca pida elevación." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Voz local" Foreground="White" Padding="12">
                    <StackPanel>
                        <CheckBox x:Name="VoiceCheck" Content="Permitir órdenes con el micrófono" />
                        <CheckBox x:Name="SpeechCheck" Content="Responder con voz local" Margin="0,8,0,0" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Voz de síntesis" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="VoiceNameBox" />
                        </Grid>
                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="La aplicación solo admite frases predefinidas; “Sharki” es opcional al usar el botón, o pulsa Ctrl+Alt+S. El modelo se carga solo durante la escucha. No guarda grabaciones ni envía audio. Las respuestas llevan siempre un timbre robótico añadido. Para más voces: Configuración de Windows → Hora e idioma → Voz, o instala un idioma adicional; solo se ven aquí las voces SAPI5 clásicas, no las voces «naturales» nuevas de Windows." />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText" Foreground="#FF6F7F" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Width="100" Margin="8,0,0,0" Click="Cancel_Click">Cancelar</Button>
            <Button Grid.Column="2" Width="100" Margin="8,0,0,0" Click="Save_Click">Guardar</Button>
        </Grid>
    </Grid>
</Window>
