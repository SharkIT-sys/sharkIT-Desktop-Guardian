<Window x:Class="SharkiDesktopGuardian.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tutorial de Sharki" Width="460" Height="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border CornerRadius="18" Background="{StaticResource PanelBrush}" BorderBrush="#5500C8FF" BorderThickness="1.5" Padding="24">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.55" BlurRadius="24" ShadowDepth="6" Direction="270" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StepCounterText" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource AppFont}" FontSize="13" />
                <Button Grid.Column="1" Content="✕" Width="28" Height="28" Padding="0" Click="Close_Click" ToolTip="Cerrar" />
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,10">
                <TextBlock x:Name="StepTitleText" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource AppFont}"
                           FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="StepBodyText" Foreground="White" FontFamily="{StaticResource AppFont}"
                           FontSize="15" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="22" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="Atrás" Width="90" Click="Back_Click" HorizontalAlignment="Left" />
                <Button Grid.Column="1" Content="Saltar" Width="90" Margin="0,0,8,0" Click="Close_Click" />
                <Button x:Name="NextButton" Grid.Column="2" Content="Siguiente" Width="110" Click="Next_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
